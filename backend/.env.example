# Backend config — copy to .env and edit.

# Where the chain lives.
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# OfflineVault deployment — read from contracts/deployments/<network>.json
VAULT_ADDRESS=
USDC_ADDRESS=

# Backend custodial signer — for demo only. Mints test USDC, locks funds for users,
# and CO-SIGNS bearer vouchers issued via the top-up flow on behalf of the customer.
# In production, the customer's own key in their phone TEE signs vouchers; backend
# just orchestrates UPI <-> on-chain. The custodial path is the demo fallback.
BACKEND_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Where the SQLite db lives.
DB_PATH=./data/offlinepay.db

# Server port.
PORT=4000
